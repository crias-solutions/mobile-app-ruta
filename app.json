
{
  "expo": {
    "name": "RUTA Mobile",
    "slug": "ruta-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/natively-dark.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/03c3eb6d-4b62-45d1-8c7d-df8b589efe1e.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.Natively",
      "icon": "./assets/images/natively-dark.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "This app collects anonymous GPS data only when your device is online to support a Citizen Science mobility study.",
        "NSMotionUsageDescription": "This app collects anonymous accelerometer, gyroscope and magnetometer data during a ride for research purposes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/03c3eb6d-4b62-45d1-8c7d-df8b589efe1e.png",
        "backgroundColor": "#4A5A7A"
      },
      "icon": "./assets/images/03c3eb6d-4b62-45d1-8c7d-df8b589efe1e.png",
      "package": "com.rutamobile.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/final_quest_240x240.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router"
    ],
    "scheme": "ruta-mobile",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
